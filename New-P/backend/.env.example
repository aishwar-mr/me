# Copy to .env and fill in. .env itself is gitignored — never commit real values.

MONGO_URL=mongodb://localhost:27017
DB_NAME=poonie

# OpenRouter key. server.py only ever calls models whose OpenRouter-listed
# price is $0 (verified at call time, not just by the ":free" name), so
# this can run at zero marginal cost regardless of the key's own limit.
OPENROUTER_API_KEY=

POONIE_LOGS_PASSCODE=
# Optional, defaults to "*" (open) if unset — set this before going public.
CORS_ORIGINS=
