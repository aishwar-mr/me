# Copy to .env and fill in. .env itself is gitignored — never commit real values.

# OpenRouter key. server.py only ever calls models whose OpenRouter-listed
# price is $0 (verified at call time, not just by the ":free" name), so
# this can run at zero marginal cost regardless of the key's own limit.
OPENROUTER_API_KEY=

# Optional, defaults to "*" (open) if unset — set this to the real site
# origin(s) before going public, e.g. https://aishwar-mr.github.io
CORS_ORIGINS=

# Optional locally: server.py falls back to reading poonie_personality.txt
# straight off disk if this is unset. On a real host, paste the file's
# contents in here instead — the .txt is gitignored and won't be there.
POONIE_PERSONALITY=
